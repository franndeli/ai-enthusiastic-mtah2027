{
  "permissions": {
    "deny": [
      "Read(~/.mtah2027/**)",
      "Edit(~/.mtah2027/**)",
      "Read(./data/**)",
      "Edit(./data/**)",
      "Read(./evaluation/reports/**)",
      "Read(**/*.mp4)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent_guard.py\""
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  }
}

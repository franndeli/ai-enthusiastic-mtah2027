  {"name": "b50", "cwd": "../ai-enthusiastic-mtah2027",
   "cmd": ["{python}", "starter/baseline.py", "--window", "50", "--out", "{outdir}"],
   "env": {"MTAH_DATA_DIR": "{data}"}, "result": "{outdir}/baseline_smooth50.csv"}
